# Local secrets file left over from the retired (never deployed) SMS
# Cloud Functions. Kept ignored so it can never be committed.
functions/.secret.local

# Retained Functions prototype (functions/) — Node tooling artifacts
functions/node_modules/
functions/lib/
functions/*.log

# Firestore rules emulator tests (firestore-tests/) — npm install output
firestore-tests/node_modules/
