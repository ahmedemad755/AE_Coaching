{
  "name": "ae-coaching-functions",
  "description": "Server-side workout inactivity reminders and FCM token ownership (built and tested locally; not deployed).",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "echo \"(no lint step configured)\"",
    "test:unit": "jest --config jest.config.js --selectProjects unit",
    "test:emulator": "jest --config jest.config.js --selectProjects emulator --runInBand",
    "test:emulator:exec": "firebase emulators:exec --only firestore,auth --project demo-ae-coaching --config ../firebase.json \"npm run test:emulator\"",
    "migrate:token-owners": "node lib/tokens/entrypoints/tokenOwnershipMigrationCli.js",
    "account:process-deletions": "node lib/account/entrypoints/accountDeletionCli.js"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.5",
    "firebase-functions-test": "^3.4.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4"
  }
}
